# Second stack on the same VM — /opt/onsys-au
#
#   cp .env.au.example .env        (inside /opt/onsys-au, NOT /opt/onsys)
#
# This file carries ONLY the values that have to differ from the live stack, with
# the reason each one matters. Everything else — ORG_*, Graph, Turnstile, Stripe,
# the site URLs — copy across from /opt/onsys/.env unchanged, or the second stack
# will not be the same application.
#
# Run scripts/preflight-au-stack.sh before `up`. It refuses to start a stack that
# collides with the live one on any of the five values below.

# ──────────────────────────────────────────────────────────────────────────────
# 1. Isolation. Get any of these wrong and the two stacks share something.
# ──────────────────────────────────────────────────────────────────────────────

# Namespaces containers, networks and volumes. Set here, it beats the `name:
# onsys` in docker-compose.prod.yml, so no -p flag has to be remembered.
COMPOSE_PROJECT_NAME=onsys-au

# The built image tag. Without this, `docker compose build` writes
# onsys-api:latest and onsys-web:latest — the tags the live containers were
# created from — so the next time the live stack recreates a container it comes
# up on this code.
IMAGE_TAG=au

# Postgres data directory. A bind mount, not a named volume, so it is NOT
# namespaced by the project name. Two clusters started against one directory
# corrupt it.
DATA_ROOT_AU=/opt/data-au

# What the edge publishes on loopback. 3009 is the live stack. HAProxy points
# at one or the other.
APP_PORT=3010

# Loopback-only Postgres port, so psql and dumps can say which cluster they
# mean. 5433 is the live stack's convention; 5432 is often a host install.
POSTGRES_HOST_PORT_AU=5434

# ──────────────────────────────────────────────────────────────────────────────
# 2. Database. A separate cluster, so it needs its own credentials and its own
#    data. Generate a fresh password — do not reuse the live one.
# ──────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=onsys
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=onsys

# Inside the compose network the host is the service name, so this is the same
# in both stacks and does not need changing. It is NOT the published port above.
DATABASE_URL=postgresql://onsys:CHANGE_ME@postgres:5432/onsys?schema=public

# ──────────────────────────────────────────────────────────────────────────────
# 3. Its own revalidation secret. Shared, a request to one stack would purge
#    the other's cache.
# ──────────────────────────────────────────────────────────────────────────────
REVALIDATE_SECRET=replace-with-a-fresh-64-char-hex-string

# ──────────────────────────────────────────────────────────────────────────────
# 4. Everything below is copied from the live .env. Listed so nothing is missed.
#    The site URLs stay identical: this stack serves the same site on the same
#    hostname once HAProxy points at it, and changing them would put the wrong
#    canonical and the wrong API base into the client bundle.
# ──────────────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000

SITE_URL=https://www.onsys.com.au
API_URL=https://www.onsys.com.au/api
NEXT_PUBLIC_SITE_URL=https://www.onsys.com.au
NEXT_PUBLIC_API_URL=https://www.onsys.com.au/api

# Analytics is inlined at build time. Set it here too or this stack serves
# without it — see the commit that added it.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=onsys.com.au

# HAProxy -> edge nginx -> api is two hops. See the warning in
# DOCKER-DEPLOYMENT.md before changing this.
TRUST_PROXY_HOPS=2

# ORG_*, GRAPH_*, TURNSTILE_*, STRIPE_*, LEAD_NOTIFY_TO, HEALTHCHECK_* and the
# rest: copy verbatim from /opt/onsys/.env.
