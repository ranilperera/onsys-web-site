# ============================================================
# Onsys platform — environment configuration
# Copy to .env and fill in. Never commit the real .env.
# ============================================================

NODE_ENV=production
PORT=4000

# --- Database ---
# Credentials for the docker-compose postgres service (pgvector/pgvector:pg16).
POSTGRES_USER=onsys
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=onsys
# Host port the container publishes on. Use 5433 if you also run a native
# Postgres on 5432; container-to-container traffic always uses 5432.
POSTGRES_HOST_PORT=5433

# Used by host-side tooling (Prisma CLI, psql). Inside compose the api service
# gets its own DATABASE_URL pointing at postgres:5432 over the container network.
DATABASE_URL=postgresql://onsys:CHANGE_ME@localhost:5433/onsys?schema=public

# ============================================================
# Organisation details
# ------------------------------------------------------------
# Every page, email, legal document and schema.org block reads these.
# Change them here and restart — no code edits required.
# ============================================================
ORG_NAME=Onsys Technologies
ORG_LEGAL_NAME=Onsys Technologies Pty Ltd
ORG_ABN=49 602 081 005
ORG_ACN=602 081 005
ORG_EMAIL=sales@onsys.com.au
ORG_PHONE=1800 431 416
# E.164 form used for tel: links
ORG_PHONE_E164=+611800431416
ORG_STREET=Level 1, 530 Little Collins Street
ORG_LOCALITY=Melbourne
ORG_REGION=VIC
ORG_POSTCODE=3000
ORG_COUNTRY=AU
ORG_BOOKING_URL=https://onsys.com.au/appointment/
# Logo served from apps/web/public
ORG_LOGO=/logo.png
# One-line summary used in meta descriptions and Organization schema
ORG_DESCRIPTION=
# Short line shown under the logo in the footer
ORG_TAGLINE=
# Social profiles — leave blank to hide the icon rather than link nowhere
ORG_LINKEDIN=https://au.linkedin.com/company/onsys-technologies
ORG_FACEBOOK=
ORG_TWITTER=
ORG_YOUTUBE=

# --- URLs ---
SITE_URL=https://www.onsys.com.au
API_URL=https://www.onsys.com.au/api
NEXT_PUBLIC_SITE_URL=https://www.onsys.com.au
NEXT_PUBLIC_API_URL=https://www.onsys.com.au/api

# ============================================================
# Microsoft Graph — transactional email
# ------------------------------------------------------------
# Azure Portal → App registrations → New registration
#   1. API permissions → Microsoft Graph → Application → Mail.Send
#   2. Grant admin consent for the tenant
#   3. Certificates & secrets → New client secret
#   4. GRAPH_SENDER_UPN must be a real licensed mailbox
#
# Strongly recommended: restrict the app to a single mailbox
#   New-ApplicationAccessPolicy -AppId <GRAPH_CLIENT_ID> \
#     -PolicyScopeGroupId <mail-enabled-security-group> -AccessRight RestrictAccess
# ============================================================
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER_UPN=noreply@onsys.com.au
LEAD_NOTIFY_TO=sales@onsys.com.au

# ============================================================
# Microsoft Teams — chat escalation
# ------------------------------------------------------------
# Option A (simplest): channel → ⋯ → Connectors → Incoming Webhook
TEAMS_WEBHOOK_URL=
#
# Option B (two-way): Graph channel messages. Requires the app registration
# above to also hold ChannelMessage.Send + ChannelMessage.Read.All
# (Application) with admin consent. Get the IDs from the channel's
# "Get link to channel" URL.
TEAMS_TEAM_ID=
TEAMS_CHANNEL_ID=
#
# Shared secret for POST /api/chat/teams-reply (Power Automate push-back).
# Generate with: openssl rand -hex 32
TEAMS_INBOUND_SECRET=

# ============================================================
# Chatbot (RAG)
# ============================================================
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Minimum cosine similarity before we trust a retrieved chunk. Raise to make
# the bot more conservative (escalates sooner), lower to make it chattier.
RAG_MIN_SCORE=0.28

# ============================================================
# Security
# ============================================================
# openssl rand -hex 32
SESSION_SECRET=
# Cloudflare Turnstile (free) — protects the contact form
TURNSTILE_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ============================================================
# Analytics (optional)
# ============================================================
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GOOGLE_VERIFICATION=
