# Normalise to LF in the repository; Git may still check out CRLF on Windows.
* text=auto

# These must be LF even in a Windows working copy. A shell script with CRLF
# endings fails inside a Linux container with "no such file or directory",
# which points at the interpreter rather than at the line endings and is
# genuinely hard to diagnose.
*.sh            text eol=lf
Dockerfile*     text eol=lf
*.conf          text eol=lf
docker-compose*.yml text eol=lf
.dockerignore   text eol=lf

# Binary — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.woff2 binary
*.pdf binary
