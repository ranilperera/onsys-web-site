// Onsys Technologies platform — data model
// PostgreSQL + pgvector (for chatbot RAG retrieval)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// ---------------------------------------------------------------
// Content
// ---------------------------------------------------------------

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Marketing pages (home, about, expertise, pricing, contact, service pages).
/// Body is stored as structured JSON blocks so the admin can reorder sections
/// without touching code.
model Page {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  status      ContentStatus @default(DRAFT)

  // Hero
  eyebrow     String?
  heading     String
  lede        String?       @db.Text

  /// Ordered array of section blocks. See packages/shared/src/blocks.ts
  blocks      Json          @default("[]")

  /// Optional full-bleed hero photograph for the page header. When set the
  /// header switches to its dark treatment (navy scrim + white type).
  heroImage   String?

  /// Optional call-to-action buttons rendered in the page header, shaped as
  /// [{ label, href }]. The first is styled as the primary action.
  heroCtas    Json?

  // SEO / AEO
  seoTitle       String?
  seoDescription String?  @db.Text
  ogImage        String?
  canonicalUrl   String?
  noindex        Boolean  @default(false)
  /// Extra JSON-LD injected verbatim (e.g. Service or FAQPage schema)
  structuredData Json?
  /// Q&A pairs surfaced as FAQPage schema + answer-engine friendly markup
  faqs           Faq[]

  navOrder    Int?
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  chunks      ContentChunk[]

  @@index([status, slug])
  @@map("pages")
}

model Category {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String? @db.Text
  /// Hex colour used for the card cover in the blog grid
  color       String  @default("#0E336A")
  posts       Post[]

  @@map("categories")
}

model Post {
  id         String        @id @default(cuid())
  slug       String        @unique
  title      String
  excerpt    String?       @db.Text
  /// Rendered HTML (sanitised on write). Markdown source kept in `bodyMarkdown`.
  bodyHtml   String        @db.Text
  bodyMarkdown String?     @db.Text
  status     ContentStatus @default(DRAFT)

  categoryId String?
  category   Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  /// Denormalised byline, kept so a post always renders one even if its
  /// Author row is removed. The relation is what drives the Person schema.
  authorName String        @default("Onsys Technologies")
  authorId   String?
  author     Author?       @relation(fields: [authorId], references: [id], onDelete: SetNull)

  readMinutes Int          @default(5)
  coverImage String?

  // SEO / AEO
  seoTitle       String?
  seoDescription String?  @db.Text
  ogImage        String?
  canonicalUrl   String?
  noindex        Boolean  @default(false)
  structuredData Json?
  faqs           Faq[]

  /// Original WordPress URL/ID, used to build 301s and avoid duplicate imports
  legacyUrl  String?       @unique
  legacyId   Int?

  publishedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  chunks     ContentChunk[]

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([authorId])
  @@map("posts")
}

/// Byline behind every post.
///
/// Exists so articles carry a Person in their JSON-LD rather than the
/// Organization. Search engines resolve a named human with a consistent
/// footprint across LinkedIn and the wider web into an entity; a company name
/// in an author slot resolves to nothing, and E-E-A-T signals depend on the
/// difference.
///
/// `name` is the only field a byline renders, so switching from a handle to a
/// real person's name later is one edit here — no schema, route or markup
/// change follows from it.
model Author {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  /// Job title shown under the byline, e.g. "Principal DBA".
  role        String?
  bio         String?  @db.Text
  photo       String?
  /// Certifications worth stating: "Microsoft Certified: Azure Database Administrator Associate".
  credentials String[] @default([])
  /// Emitted as schema.org sameAs. Without at least one of these the Person
  /// node is unverifiable and does the entity-resolution job poorly.
  linkedIn    String?
  website     String?

  posts       Post[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("authors")
}

/// FAQ entries power both on-page accordions and FAQPage JSON-LD (AEO).
model Faq {
  id       String  @id @default(cuid())
  question String  @db.Text
  answer   String  @db.Text
  order    Int     @default(0)

  pageId   String?
  page     Page?   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  postId   String?
  post     Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@index([postId])
  @@map("faqs")
}

/// 301 map so WordPress URLs keep their link equity after cutover.
model Redirect {
  id        String   @id @default(cuid())
  fromPath  String   @unique
  toPath    String
  statusCode Int     @default(301)
  hits      Int      @default(0)
  createdAt DateTime @default(now())

  @@map("redirects")
}

// ---------------------------------------------------------------
// Chatbot (hybrid RAG + Teams escalation)
// ---------------------------------------------------------------

/// Vector-indexed chunks of page/post content for retrieval.
/// The `embedding` column is added by migration as vector(1536) — Prisma has no
/// native vector type, so it is declared Unsupported and queried via $queryRaw.
model ContentChunk {
  id        String  @id @default(cuid())
  content   String  @db.Text
  tokens    Int     @default(0)
  /// Human-readable source label shown as a citation in the chat widget
  sourceUrl String
  sourceTitle String

  pageId    String?
  page      Page?   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  postId    String?
  post      Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)

  embedding Unsupported("vector(1536)")?

  createdAt DateTime @default(now())

  @@index([pageId])
  @@index([postId])
  @@map("content_chunks")
}

enum ChatStatus {
  /// AI is handling the conversation
  BOT
  /// Escalated — waiting for a human in Teams to pick it up
  WAITING_HUMAN
  /// A human in Teams is actively replying
  HUMAN
  CLOSED
}

model ChatSession {
  id            String     @id @default(cuid())
  status        ChatStatus @default(BOT)

  visitorName   String?
  visitorEmail  String?
  /// Page the widget was opened on — useful context for the human agent
  entryUrl      String?
  userAgent     String?
  /// Kept for rate limiting and abuse correlation without exposing the address.
  ipHash        String?
  /// The address itself, for the audit trail on who chatted from where.
  /// Personal information under the Privacy Act — covered by the privacy
  /// policy, and subject to the same retention limits as the transcript.
  ipAddress     String?

  /// Email verification gate. The chat stays locked until the visitor enters
  /// the code we email them, which is what makes visitorEmail worth treating
  /// as a lead rather than as whatever they felt like typing.
  emailVerified Boolean   @default(false)
  /// SHA-256 of sessionId + code. Never the code itself: a leaked database
  /// row must not hand someone a working credential.
  otpHash       String?
  otpExpiresAt  DateTime?
  otpSentAt     DateTime?
  otpAttempts   Int        @default(0)

  /// Teams conversation/message id used to thread replies back to this session
  teamsThreadId String?
  escalatedAt   DateTime?
  /// When the visitor was told to phone a live incident through. Set once, so
  /// a conversation about an outage does not fire a card on every message.
  incidentNotifiedAt DateTime?
  closedAt      DateTime?

  messages      ChatMessage[]
  lead          Lead?

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([status, updatedAt])
  @@index([teamsThreadId])
  @@index([visitorEmail])
  @@map("chat_sessions")
}

enum ChatRole {
  VISITOR
  ASSISTANT
  AGENT
  SYSTEM
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  role      ChatRole
  content   String      @db.Text
  /// Agent display name when role = AGENT
  authorName String?
  /// Retrieval citations backing an ASSISTANT answer
  citations Json?

  createdAt DateTime    @default(now())

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

// ---------------------------------------------------------------
// Leads & users
// ---------------------------------------------------------------

enum LeadSource {
  CONTACT_FORM
  CHAT
  NEWSLETTER
  /// Came in through the emergency page — worth reporting on separately,
  /// since these are companies running production without an agreement.
  EMERGENCY
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
}

model Lead {
  id        String     @id @default(cuid())
  name      String
  email     String
  company   String?
  phone     String?
  service   String?
  message   String?    @db.Text

  status    LeadStatus @default(NEW)
  channel   LeadSource @default(CONTACT_FORM)

  /// Set when the lead came out of a chat conversation
  sessionId String?      @unique
  session   ChatSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  /// Marketing attribution
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  referrer    String?

  emailSentAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([channel, createdAt])
  @@map("leads")
}

enum Role {
  ADMIN
  EDITOR
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(EDITOR)
  lastLoginAt  DateTime?

  /// Authenticator-app secret, base32. Present once setup has been started;
  /// totpEnabledAt is what marks it confirmed and in use, so an abandoned
  /// enrolment never becomes a factor nobody can satisfy.
  totpSecret     String?
  totpEnabledAt  DateTime?
  /// SHA-256 of each single-use recovery code. Hashed for the same reason the
  /// password is: these are long-lived admin credentials, and a leaked table
  /// of plaintext codes is a leaked table of logins. Removed as they are used.
  recoveryCodes  String[]  @default([])

  challenges   MfaChallenge[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

enum EmergencyStatus {
  /// Details captured, checkout not completed
  PENDING
  PAID
  CANCELLED
  FAILED
}

/// A prepaid emergency support block.
///
/// The row is written before Stripe is involved, so an abandoned checkout still
/// leaves the enquiry visible to the team — someone with a production outage
/// who gave up at the payment screen is exactly who should be called back.
model EmergencyRequest {
  id          String          @id @default(cuid())
  name        String
  company     String?
  phone       String
  email       String
  summary     String?         @db.Text

  hours       Int             @default(4)
  /// Charged amount in the smallest currency unit, recorded as Stripe reported
  /// it. Never recomputed from the page: the receipt has to match the charge.
  amountCents Int?
  currency    String          @default("aud")

  status      EmergencyStatus @default(PENDING)
  stripeSessionId       String? @unique
  stripePaymentIntentId String?
  paidAt      DateTime?

  ipHash      String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@map("emergency_requests")
}

/// A password accepted, second factor still outstanding.
///
/// Deliberately not an AdminSession: until the second factor lands there is no
/// session, so a stolen password alone yields a row that can open nothing.
model MfaChallenge {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Wrong attempts across every method. Burns the challenge, not the account,
  /// so an attacker cannot lock a real admin out by guessing at them.
  attempts       Int       @default(0)

  /// Emailed fallback code, for a lost or not-yet-enrolled authenticator.
  emailOtpHash   String?
  emailOtpSentAt DateTime?

  expiresAt      DateTime
  createdAt      DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("mfa_challenges")
}

/// Server-side sessions for the admin CMS (httpOnly cookie holds the id).
model AdminSession {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("admin_sessions")
}

/// A consultation slot a visitor reserved on the public site.
model Booking {
  id        String        @id @default(cuid())
  /// Short human-quotable code, e.g. ONS-7QK2M4. What support asks for.
  reference String        @unique

  name      String
  email     String
  company   String?
  phone     String?
  topic     String?
  message   String?       @db.Text

  /// Always stored UTC. `timezone` records the zone the visitor booked in so a
  /// later reschedule can be shown back to them in their own wall-clock time.
  startsAt  DateTime
  endsAt    DateTime
  timezone  String

  status    BookingStatus @default(PENDING)

  /// Graph identifiers for the calendar event we created on the consultant's
  /// mailbox. Null while PENDING, and after the event has been deleted.
  graphEventId String?
  /// Teams meeting the visitor joins. Never exposed to anyone but them.
  joinUrl      String?    @db.Text

  /// Unguessable token backing the self-service cancellation link.
  cancelToken String     @unique
  cancelledAt DateTime?

  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  referrer    String?

  confirmationSentAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([startsAt, status])
  @@index([email, createdAt])
  @@map("bookings")
}

enum BookingStatus {
  /// Persisted, but the calendar event has not been written yet.
  PENDING
  CONFIRMED
  CANCELLED
  /// Graph rejected the event. Kept so staff can follow up by hand.
  FAILED
}

/// A link in the site footer, editable from the admin console.
///
/// The footer used to be a literal in the web app's config, which meant every
/// wording change was a code change and a redeploy. Rows here replace that
/// list; the config literal survives only as the fallback used when the API is
/// unreachable, so a failed request degrades to the old footer rather than to
/// no footer at all.
model NavLink {
  id      String  @id @default(cuid())
  /// Column heading it appears under, e.g. "Services". Free text so a new
  /// column can be created without a migration.
  group      String
  /// Position of the whole column in the footer. Held on every link rather
  /// than in a second table: ordering by the group name alone would put
  /// Company before Services, which is not the order the footer reads in.
  groupOrder Int    @default(0)
  label   String
  href    String
  /// Position within the group. Gaps are fine — only the ordering matters.
  order   Int     @default(0)
  /// Lets a link be retired without losing its wording and position.
  visible Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([group, order])
  @@map("nav_links")
}
